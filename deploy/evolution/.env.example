# --- Evolution API (gateway WhatsApp) ---
# Copia este archivo a .env en deploy/evolution/ y rellena los valores.

# Llave global de la API. Genera una cadena larga aleatoria:
#   php -r "echo bin2hex(random_bytes(24));"
EVOLUTION_API_KEY=

# Password del PostgreSQL interno de Evolution (no es el de ChatMe)
POSTGRES_PASSWORD=

# Puerto en el host donde se expone Evolution
EVOLUTION_PORT=8080

# URL pública del gateway:
#   - local: http://localhost:8080
#   - producción: https://wa.chatme.com.mx (o la IP/puerto del VPS)
SERVER_URL=http://localhost:8080

# ERROR en producción, DEBUG para diagnosticar
EVOLUTION_LOG_LEVEL=ERROR
