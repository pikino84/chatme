# Redis connection (debe coincidir con el de Laravel)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Prefijo de canales pub/sub — mismo prefix que usa Laravel
# Canales: {PREFIX}:outbound:{channel_id}, {PREFIX}:inbound:{channel_id}, {PREFIX}:status:{channel_id}
WA_BRIDGE_PREFIX=wa

# Directorio donde se guardan las sesiones Baileys (auth state por canal)
SESSIONS_DIR=./sessions

# Nivel de log (trace, debug, info, warn, error)
LOG_LEVEL=info
